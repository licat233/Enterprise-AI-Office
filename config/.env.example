# Enterprise AI Office — non-secret environment template
#
# Copy/adapt to a protected deployment-specific location. Never commit real credentials.

# ---- General ----
EAIO_ENVIRONMENT=production
EAIO_COMPANY_ID=example-company
EAIO_TIMEZONE=Asia/Shanghai

# ---- Service URLs used by health tooling ----
OPEN_WEBUI_HEALTH_URL=http://127.0.0.1:3000/health
WEKNORA_HEALTH_URL=<SET_DEPLOYED_WEKNORA_HEALTH_URL>
HERMES_HEALTH_URL=http://127.0.0.1:8642/health
HERMES_WEBUI_HEALTH_URL=

# ---- Open WebUI first-admin bootstrap ----
OPEN_WEBUI_ADMIN_EMAIL=<ADMIN_EMAIL>
OPEN_WEBUI_ADMIN_PASSWORD=<GENERATE_STRONG_ADMIN_PASSWORD>
OPEN_WEBUI_ADMIN_NAME=AI Administrator

# ---- Backup/health monitoring ----
EAIO_BACKUP_SUCCESS_MARKER=
EAIO_BACKUP_MAX_AGE_HOURS=36
EAIO_DISK_WARN_PERCENT=70
EAIO_DISK_FAIL_PERCENT=85

# ---- Core protected secrets ----
HERMES_DEFAULT_API_KEY=<GENERATE_STRONG_SECRET>
HERMES_GENERAL_API_KEY=<GENERATE_DISTINCT_STRONG_SECRET>
MODEL_PROVIDER_API_KEY=<PROTECTED_SECRET>
WEKNORA_DB_PASSWORD=<GENERATE_STRONG_SECRET>
REDIS_PASSWORD=<GENERATE_STRONG_SECRET_IF_REQUIRED>

# ---- Conditional Profile secrets ----
# Add one distinct API key and only the credentials required by each enabled specialist Profile.
# HERMES_<PROFILE>_API_KEY=<GENERATE_DISTINCT_STRONG_SECRET>

# ---- Optional hermes-webui ----
# Required when the admin WebUI is reachable beyond loopback; may also be required by company policy on loopback.
HERMES_WEBUI_PASSWORD=<OPTIONAL_PROTECTED_SECRET>

# ---- Optional coding-agent authentication ----
# Prefer each CLI's supported login/credential store under the actual Hermes service user.
# Only set API-key style credentials when that selected backend/auth mode requires them.
CODEX_API_KEY=<OPTIONAL_PROTECTED_SECRET>
ANTHROPIC_API_KEY=<OPTIONAL_PROTECTED_SECRET>

# ---- Optional messaging ----
FEISHU_APP_ID=<OPTIONAL_PROTECTED_SECRET>
FEISHU_APP_SECRET=<OPTIONAL_PROTECTED_SECRET>
WECOM_CREDENTIALS=<OPTIONAL_PROTECTED_SECRET>
WEIXIN_CREDENTIALS=<OPTIONAL_PROTECTED_SECRET>

# ---- Optional SSO / enterprise identity ----
SSO_CLIENT_ID=<OPTIONAL_PROTECTED_SECRET>
SSO_CLIENT_SECRET=<OPTIONAL_PROTECTED_SECRET>

# Provider/platform-specific secret names may differ. Use the exact selected upstream
# release's native variables/configuration rather than forcing these generic aliases.
