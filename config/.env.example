# Enterprise AI Office — non-secret environment template
#
# Copy to a protected deployment-specific location and replace placeholders.
# Never commit real credentials.

# ---- General ----
EAIO_ENVIRONMENT=production
EAIO_COMPANY_ID=example-company
EAIO_TIMEZONE=Asia/Shanghai

# ---- Service URLs used by local health tooling ----
# Keep internal services private. These are examples only.
OPEN_WEBUI_HEALTH_URL=http://127.0.0.1:3000/health
WEKNORA_HEALTH_URL=http://127.0.0.1:8080/health
HERMES_HEALTH_URL=http://127.0.0.1:8642/health

# Optional admin/client health URLs
HERMES_WEBUI_HEALTH_URL=

# ---- Backup monitoring ----
# Point to a marker/file updated after a successful backup, if your deployment uses one.
EAIO_BACKUP_SUCCESS_MARKER=
EAIO_BACKUP_MAX_AGE_HOURS=36

# ---- Disk health thresholds ----
EAIO_DISK_WARN_PERCENT=70
EAIO_DISK_FAIL_PERCENT=85

# ---- Protected secrets: placeholders only ----
# Do NOT put real values into this tracked example file.
HERMES_GENERAL_API_KEY=<GENERATE_STRONG_SECRET>
HERMES_SALES_API_KEY=<GENERATE_STRONG_SECRET>
HERMES_QC_API_KEY=<GENERATE_STRONG_SECRET>
HERMES_MARKETING_API_KEY=<GENERATE_STRONG_SECRET>
HERMES_ENGINEERING_API_KEY=<GENERATE_STRONG_SECRET>

WEKNORA_DB_PASSWORD=<GENERATE_STRONG_SECRET>
REDIS_PASSWORD=<GENERATE_STRONG_SECRET_IF_REQUIRED>
MODEL_PROVIDER_API_KEY=<PROTECTED_SECRET>

# Messaging credentials are only needed when that platform is enabled.
FEISHU_APP_ID=<OPTIONAL_PROTECTED_SECRET>
FEISHU_APP_SECRET=<OPTIONAL_PROTECTED_SECRET>
WECOM_CREDENTIALS=<OPTIONAL_PROTECTED_SECRET>
WEIXIN_CREDENTIALS=<OPTIONAL_PROTECTED_SECRET>
