# Enterprise AI Office baseline Hermes default/admin Profile secrets
# Copy to the protected default Hermes .env and replace placeholders.
# Never commit the real file.

API_SERVER_ENABLED=true
API_SERVER_KEY=<GENERATE_STRONG_DEFAULT_CONTROL_PLANE_KEY>
API_SERVER_PORT=8642

# Bind to the narrowest address that is reachable by the selected Open WebUI runtime.
# The validated OrbStack demo required a host address reachable from the container bridge.
API_SERVER_HOST=<RESOLVE_TRUSTED_BIND_ADDRESS>

# Provider credentials/authentication are deployment-specific and must follow the
# pinned Hermes provider documentation. Keep them in this protected secret scope.
