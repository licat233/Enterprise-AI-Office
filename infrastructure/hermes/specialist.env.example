# Generic specialist Hermes Profile secret template.
# Copy to ~/.hermes/profiles/<profile>/.env with restrictive permissions.
# Never commit real values.

API_SERVER_ENABLED=true
API_SERVER_KEY=<GENERATE_DISTINCT_PROFILE_API_KEY>
API_SERVER_MODEL_NAME=<PROFILE_ID>

# In a multiplexed Gateway, the listener is owned by the default Profile.
# Keep employee Profile credentials distinct even though the process is shared.

WEKNORA_API_KEY=<PROFILE_SCOPED_RETRIEVAL_KEY>
WEKNORA_BASE_URL=<DEPLOYED_WEKNORA_API_BASE_URL>

# Add provider credentials only when they are not inherited through the selected
# supported provider/auth mechanism. Do not copy unrelated company credentials
# into a specialist Profile.
