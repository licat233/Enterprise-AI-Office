# Enterprise AI Office baseline Hermes `general` Profile secrets
# Copy to ~/.hermes/profiles/general/.env and replace placeholders.
# Never commit the real file.

# In multiplex mode the shared listener authenticates /p/general/... with this
# Profile-scoped key. Do not set API_SERVER_ENABLED on the secondary Profile.
API_SERVER_KEY=<GENERATE_DISTINCT_STRONG_GENERAL_PROFILE_KEY>

# WeKnora MCP access for this Profile.
WEKNORA_API_KEY=<PROTECTED_READ_ONLY_WEKNORA_KEY>
WEKNORA_BASE_URL=<DEPLOYED_WEKNORA_API_V1_URL>

# Resolve models.hermes.credential_refs through secret_refs. For API-key
# providers, add each secret only at its exact native_binding accepted by the
# pinned Hermes PROVIDER_REGISTRY (for example OPENAI_API_KEY for openai-api).
# Keyless/OAuth/account providers do not require an invented API-key variable.
