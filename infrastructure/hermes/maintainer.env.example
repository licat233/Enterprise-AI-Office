# Enterprise AI Office EAO Admin `maintainer` Profile protected inputs.
# Copy to the protected maintainer Profile environment only for an explicitly
# authorized runtime deployment. Never commit real values.

# Shared Hermes multiplex listener credential for /p/maintainer/...
API_SERVER_KEY=<GENERATE_DISTINCT_STRONG_MAINTAINER_PROFILE_KEY>

# Read-only WeKnora retrieval path used by Hermes for review and post-ingest
# verification. This is NOT the contributor key used by the Open WebUI Action.
WEKNORA_API_KEY=<PROTECTED_READ_ONLY_WEKNORA_KEY>
WEKNORA_BASE_URL=<DEPLOYED_WEKNORA_API_V1_URL>

# Reuse the existing bounded Enterprise Web Research capability.
FIRECRAWL_API_KEY=<PROTECTED_FIRECRAWL_CREDENTIAL>
EAIO_WEB_RESEARCH_BIN=<APPROVED_ENTERPRISE_WEB_RESEARCH_ADAPTER>
EAIO_OBSCURA_BIN=<APPROVED_OBSCURA_BIN>
EAIO_OBSCURA_STORAGE_DIR=<APPROVED_OBSCURA_STORAGE_DIR>
EAIO_CLOAKBROWSER_PYTHON=<APPROVED_CLOAKBROWSER_PYTHON>
EAIO_CLOAKBROWSER_WORKER=<APPROVED_CLOAKBROWSER_WORKER>
EAIO_CLOAKBROWSER_STORAGE_DIR=<APPROVED_CLOAKBROWSER_STORAGE_DIR>
EAIO_CLOAKBROWSER_VERSION=<PINNED_CLOAKBROWSER_VERSION>

# Reuse existing ToolScout. The routing overlay exposes only the read/review
# subset and gives the maintainer a separate ToolScout agent identity.
EAIO_TOOLSCOUT_BIN=<APPROVED_TOOLSCOUT_BIN>

# Provider credentials for the selected Hermes model belong here only when the
# pinned provider requires them. Do not copy unrelated company credentials.
