# Tencent Enterprise Mail governed SMTP adapter environment.
# Installation-design template only. Copy to a protected untracked runtime
# location on an explicitly authorized target. Never commit real credentials.

# Re-verify current Tencent Enterprise Mail official client/admin documentation
# before real activation. The current reference candidate is SMTP over SSL 465.
EAIO_EMAIL_SMTP_HOST=smtp.exmail.qq.com
EAIO_EMAIL_SMTP_PORT=465
EAIO_EMAIL_SMTP_TLS_MODE=ssl

# Must resolve to the exact configured sender mailbox. The Governance service
# separately enforces that visible From + envelope MAIL FROM + mailbox policy agree.
EAIO_EMAIL_SMTP_USERNAME=<PILOT_MAILBOX>

# Prefer the provider-supported mailbox/client-specific credential. Secret value
# stays outside Git/logs/audit/prompt/browser state.
EAIO_EMAIL_CLIENT_PASSWORD=<PROTECTED_CLIENT_PASSWORD>

# Bounded connection timeout. DATA-phase timeout does NOT imply not-sent; after
# DATA begins, missing final SMTP response maps to OUTCOME_UNKNOWN.
EAIO_EMAIL_SMTP_TIMEOUT_SECONDS=30
