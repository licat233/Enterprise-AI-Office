# Tencent Enterprise Mail read-only IMAP adapter environment.
# Copy to a protected untracked runtime location. Never commit real credentials.

# Tencent documents SSL IMAP on port 993.
# Use hwimap.exmail.qq.com only when the real deployment network benefits from
# Tencent's documented overseas endpoint and acceptance verifies it.
EAIO_EMAIL_IMAP_HOST=imap.exmail.qq.com
EAIO_EMAIL_IMAP_PORT=993

# Full mailbox address. ARMOR's actual pilot value belongs in its protected
# deployment configuration/reference state, not in this generic template.
EAIO_EMAIL_USERNAME=<PILOT_MAILBOX>

# Prefer a mailbox-specific client password when Tencent security login is
# enabled. This secret must stay outside Git/logs and be scoped to this mailbox.
EAIO_EMAIL_CLIENT_PASSWORD=<PROTECTED_CLIENT_PASSWORD>

# Initial v2 scope is deliberately narrow.
EAIO_EMAIL_ALLOWED_FOLDERS=INBOX

# Bound read size and search work so one tool call cannot pull an arbitrary
# mailbox dump. Increase only after a measured pilot need.
EAIO_EMAIL_MAX_BODY_BYTES=262144
EAIO_EMAIL_SEARCH_SCAN_LIMIT=100
